PORT=8020
HOST=0.0.0.0
API_BASE_URL=
CORS_ORIGINS=*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Login pengguna (Firebase Authentication). Isi JSON service account satu baris.
# Tanpa nilai ini, endpoint /api/account/* menjawab 503 dan aplikasi tetap mode lokal.
FIREBASE_SERVICE_ACCOUNT=

# Verifikasi ulang sebelum hapus akun.
# Web API key Firebase (Project settings > General > Web API Key), untuk verifikasi password di server.
FIREBASE_WEB_API_KEY=
# OAuth Web client ID Google (Authentication > Sign-in method > Google > Web SDK configuration),
# untuk memverifikasi bukti popup Google. Tanpa ini, hapus akun Google-only ditolak (fail closed).
GOOGLE_OAUTH_CLIENT_ID=
# Opsional bila memakai kredensial Google (base64) + project id
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# FIREBASE_PROJECT_ID=
