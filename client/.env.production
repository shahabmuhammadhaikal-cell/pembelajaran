# Dipakai hanya oleh `npm run build` (Vite mode production).
# `npm run dev` tidak membaca file ini, jadi dev tetap memakai proxy same-origin
# di vite.config.js dan tidak berubah.
#
# Frontend di Firebase Hosting / GitHub Pages tidak bisa memakai path relatif
# `/api` (yang akan menunjuk ke origin hosting), jadi build production perlu
# URL backend absolut. Ganti nilainya bila domain Render kamu berbeda.
VITE_API_BASE=https://pembelajaran-api.onrender.com/
